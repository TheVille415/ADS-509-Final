# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.env
.venv
venv/

# ----------------------------
# Jupyter
# ----------------------------
.ipynb_checkpoints/

# ----------------------------
# macOS
# ----------------------------
.DS_Store

# ----------------------------
# Data folders (keep structure, ignore contents)
# ----------------------------

# Ignore everything inside data/
data/raw/*
data/processed/*

# But keep the folders themselves
!data/raw/
!data/processed/

# Keep placeholder files if added
!data/raw/.gitkeep
!data/processed/.gitkeep

# ----------------------------
# Output folders
# ----------------------------
outputs/*
!outputs/
!outputs/.gitkeep

# ----------------------------
# CSV files anywhere (safety net)
# ----------------------------
*.csv