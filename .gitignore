# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
.env
.venv
venv/

# ----------------------------
# Jupyter
# ----------------------------
.ipynb_checkpoints/

# ----------------------------
# macOS
# ----------------------------
.DS_Store

# ----------------------------
# Data folders (keep structure, ignore contents)
# ----------------------------

# Ignore all files inside raw and processed
data/raw/*
data/processed/*

# Do NOT ignore the folders themselves
!data/raw/
!data/processed/

# Allow placeholder files
!data/raw/.gitkeep
!data/processed/.gitkeep

# ----------------------------
# Output folders
# ----------------------------

outputs/*
!outputs/
!outputs/.gitkeep

# ----------------------------
# CSV safety net
# ----------------------------
*.csv